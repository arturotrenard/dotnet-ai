<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- MAF's Skills API (AgentSkillsProviderBuilder, AgentFileSkillsSourceOptions, ...) is
             marked [Experimental("MAAI001")] upstream. -->
        <NoWarn>$(NoWarn);MAAI001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Dapr.Workflow" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Diagrid.AI.Microsoft.AgentFramework\Diagrid.AI.Microsoft.AgentFramework.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- skills/ and backtest/ are used in place from the project directory (the learning
             workflow writes new skill versions into skills/), so they are not copied to bin/. -->
        <None Remove="workspace\**" />
        <Content Remove="workspace\**" />
        <Content Update="skills\**\*.json" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    </ItemGroup>

</Project>
